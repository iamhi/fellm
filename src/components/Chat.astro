---
// src/components/Chat.astro
---

<div class="h-full flex flex-col bg-white rounded-lg border-2 border-gray-200 shadow-sm overflow-hidden">
  
  <!-- Chat Header -->
  <div class="flex-none border-b border-gray-200 px-4 sm:px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="toggleSidebar" class="lg:hidden text-gray-600 hover:text-gray-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <div class="flex items-center gap-2">
          <div id="statusIndicator" class="w-2 h-2 bg-gray-400 rounded-full"></div>
          <span id="statusText" class="text-sm font-medium text-gray-500">Not Connected</span>
        </div>
      </div>
      <button 
        id="clearChat" 
        class="text-sm text-gray-500 hover:text-gray-700 transition-colors"
      >
        Clear
      </button>
    </div>
  </div>

  <!-- Messages Container -->
  <div id="messagesContainer" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
    <!-- Welcome message -->
    <div class="flex justify-start">
      <div class="max-w-[85%] sm:max-w-[75%] lg:max-w-[60%]">
        <div class="bg-gray-100 rounded-2xl rounded-tl-md px-4 py-3">
          <p class="text-gray-800 text-sm sm:text-base">
            👋 Welcome to Fellm. Configure your API settings to get started!
          </p>
        </div>
        <span class="text-xs text-gray-400 mt-1.5 ml-1 block">Just now</span>
      </div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="flex-none border-t border-gray-200 p-4 sm:p-6">
    <form id="chatForm" class="flex gap-2 sm:gap-3">
      <input
        type="text"
        id="messageInput"
        placeholder="Type a message..."
        class="flex-1 px-4 py-2.5 sm:py-3 text-sm sm:text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent"
        autocomplete="off"
      />
      <button
        type="submit"
        id="sendButton"
        class="px-4 sm:px-6 py-2.5 sm:py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-sm sm:text-base font-medium disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Send
      </button>
    </form>
  </div>
</div>

<script>
  const messagesContainer = document.getElementById('messagesContainer');
  const chatForm = document.getElementById('chatForm');
  const messageInput = document.getElementById('messageInput') as HTMLInputElement;
  const sendButton = document.getElementById('sendButton') as HTMLButtonElement;
  const clearChatBtn = document.getElementById('clearChat');
  const toggleSidebarBtn = document.getElementById('toggleSidebar');
  const statusIndicator = document.getElementById('statusIndicator');
  const statusText = document.getElementById('statusText');

  let currentChatId = 1;
  const chatHistories = new Map<number, string>();
  let isGenerating = false;

  interface APISettings {
    provider: string;
    key?: string;
    ollamaUrl?: string;
    model: string;
    temperature: number;
    maxTokens: number;
  }

  interface MCPServer {
    id: string;
    name: string;
    type: 'stdio' | 'sse';
    command?: string;
    args?: string[];
    url?: string;
    enabled: boolean;
  }

  function getAPISettings(): APISettings | null {
    try {
      const saved = localStorage.getItem('fellm-settings');
      if (saved) {
        const settings = JSON.parse(saved);
        return settings.api;
      }
    } catch (error) {
      console.error('Failed to load API settings:', error);
    }
    return null;
  }

  function getMCPServers(): MCPServer[] {
    try {
      const saved = localStorage.getItem('fellm-settings');
      if (saved) {
        const settings = JSON.parse(saved);
        return settings.mcpServers?.filter((s: MCPServer) => s.enabled) || [];
      }
    } catch (error) {
      console.error('Failed to load MCP servers:', error);
    }
    return [];
  }

  function updateConnectionStatus() {
    const settings = getAPISettings();
    const mcpServers = getMCPServers();
    
    if (settings && (settings.provider === 'ollama' || settings.key)) {
      statusIndicator?.classList.remove('bg-gray-400');
      statusIndicator?.classList.add('bg-green-500');
      
      const mcpCount = mcpServers.length;
      statusText!.textContent = mcpCount > 0 ? `Connected (+${mcpCount} MCP)` : 'Connected';
      statusText?.classList.remove('text-gray-500');
      statusText?.classList.add('text-gray-700');
    } else {
      statusIndicator?.classList.remove('bg-green-500');
      statusIndicator?.classList.add('bg-gray-400');
      statusText!.textContent = 'Not Connected';
      statusText?.classList.remove('text-gray-700');
      statusText?.classList.add('text-gray-500');
    }
  }

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  function getCurrentTime() {
    return new Date().toLocaleTimeString('en-US', { 
      hour: 'numeric', 
      minute: '2-digit' 
    });
  }

  function saveChatHistory() {
    if (messagesContainer) {
      chatHistories.set(currentChatId, messagesContainer.innerHTML);
    }
  }

  function loadChatHistory(chatId: number) {
    if (messagesContainer) {
      const history = chatHistories.get(chatId);
      if (history) {
        messagesContainer.innerHTML = history;
      } else {
        // Load default welcome message
        messagesContainer.innerHTML = `
          <div class="flex justify-start">
            <div class="max-w-[85%] sm:max-w-[75%] lg:max-w-[60%]">
              <div class="bg-gray-100 rounded-2xl rounded-tl-md px-4 py-3">
                <p class="text-gray-800 text-sm sm:text-base">
                  👋 Welcome to Fellm. Configure your API settings to get started!
                </p>
              </div>
              <span class="text-xs text-gray-400 mt-1.5 ml-1 block">Just now</span>
            </div>
          </div>
        `;
      }
      scrollToBottom();
    }
  }

  function addMessage(text: string, isUser: boolean) {
    if (!messagesContainer) return;

    const messageDiv = document.createElement('div');
    messageDiv.className = `flex ${isUser ? 'justify-end' : 'justify-start'} animate-fadeIn`;
    
    messageDiv.innerHTML = `
      <div class="max-w-[85%] sm:max-w-[75%] lg:max-w-[60%]">
        <div class="${
          isUser 
            ? 'bg-gray-900 text-white rounded-2xl rounded-tr-md' 
            : 'bg-gray-100 text-gray-800 rounded-2xl rounded-tl-md'
        } px-4 py-3">
          <p class="text-sm sm:text-base whitespace-pre-wrap">${text}</p>
        </div>
        <span class="text-xs ${isUser ? 'text-gray-400 text-right' : 'text-gray-400'} mt-1.5 ml-1 block">
          ${getCurrentTime()}
        </span>
      </div>
    `;

    messagesContainer.appendChild(messageDiv);
    scrollToBottom();
    saveChatHistory();

    // Update sidebar with first message as title
    if (isUser) {
      const messages = messagesContainer.querySelectorAll('.flex');
      if (messages.length === 2) { // First user message (after welcome)
        const shortTitle = text.length > 30 ? text.substring(0, 30) + '...' : text;
        window.dispatchEvent(new CustomEvent('chatUpdate', {
          detail: { 
            chatId: currentChatId, 
            title: shortTitle,
            lastMessage: text
          }
        }));
      }
    }
  }

  function addLoadingMessage(): HTMLElement | null {
    if (!messagesContainer) return null;

    const loadingDiv = document.createElement('div');
    loadingDiv.className = 'flex justify-start animate-fadeIn';
    loadingDiv.id = 'loadingMessage';
    
    loadingDiv.innerHTML = `
      <div class="max-w-[85%] sm:max-w-[75%] lg:max-w-[60%]">
        <div class="bg-gray-100 text-gray-800 rounded-2xl rounded-tl-md px-4 py-3">
          <div class="flex items-center gap-2">
            <div class="flex gap-1">
              <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce"></div>
              <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
              <div class="w-2 h-2 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
            </div>
            <span class="text-sm text-gray-600">Thinking...</span>
          </div>
        </div>
      </div>
    `;

    messagesContainer.appendChild(loadingDiv);
    scrollToBottom();
    return loadingDiv;
  }

  function removeLoadingMessage() {
    const loadingMsg = document.getElementById('loadingMessage');
    if (loadingMsg) {
      loadingMsg.remove();
    }
  }

  async function callOllamaAPI(messages: any[], settings: APISettings): Promise<string> {
    const url = settings.ollamaUrl || 'http://localhost:11434';
    
    const response = await fetch(`${url}/api/chat`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: settings.model,
        messages: messages,
        stream: false,
        options: {
          temperature: settings.temperature,
          num_predict: settings.maxTokens,
        }
      })
    });

    if (!response.ok) {
      throw new Error(`Ollama API error: ${response.statusText}`);
    }

    const data = await response.json();
    return data.message.content;
  }

  async function callOpenAIAPI(messages: any[], settings: APISettings): Promise<string> {
    const response = await fetch('https://api.openai.com/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${settings.key}`
      },
      body: JSON.stringify({
        model: settings.model,
        messages: messages,
        temperature: settings.temperature,
        max_tokens: settings.maxTokens,
      })
    });

    if (!response.ok) {
      throw new Error(`OpenAI API error: ${response.statusText}`);
    }

    const data = await response.json();
    return data.choices[0].message.content;
  }

  async function callAnthropicAPI(messages: any[], settings: APISettings): Promise<string> {
    const mcpServers = getMCPServers();
    
    // Convert OpenAI format to Anthropic format
    const anthropicMessages = messages.map((msg: any) => ({
      role: msg.role === 'assistant' ? 'assistant' : 'user',
      content: msg.content
    }));

    const requestBody: any = {
      model: settings.model,
      messages: anthropicMessages,
      max_tokens: settings.maxTokens,
      temperature: settings.temperature,
    };

    // Add MCP tools if available
    if (mcpServers.length > 0) {
      // Note: This is a simplified example. In production, you would need to:
      // 1. Connect to each MCP server
      // 2. Fetch available tools from each server
      // 3. Format them according to Anthropic's tool format
      
      requestBody.tools = mcpServers.map(server => ({
        name: `mcp_${server.id}`,
        description: `Access to ${server.name} MCP server`,
        input_schema: {
          type: "object",
          properties: {
            action: { type: "string", description: "Action to perform" },
            params: { type: "object", description: "Action parameters" }
          },
          required: ["action"]
        }
      }));
    }

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': settings.key!,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify(requestBody)
    });

    if (!response.ok) {
      throw new Error(`Anthropic API error: ${response.statusText}`);
    }

    const data = await response.json();
    
    // Handle tool use if present
    if (data.content.some((block: any) => block.type === 'tool_use')) {
      // For now, just return the text content
      // In production, you would execute the tool and continue the conversation
      return data.content
        .filter((block: any) => block.type === 'text')
        .map((block: any) => block.text)
        .join('\n') || 'Tool execution requested (not yet implemented)';
    }
    
    return data.content[0].text;
  }

  async function generateResponse(userMessage: string) {
    const settings = getAPISettings();
    
    if (!settings) {
      addMessage('⚠️ Please configure your API settings first. Go to Settings → API Configuration.', false);
      return;
    }

    if (settings.provider !== 'ollama' && !settings.key) {
      addMessage('⚠️ API key is required. Please add your API key in Settings.', false);
      return;
    }

    isGenerating = true;
    sendButton.disabled = true;
    messageInput.disabled = true;

    const loadingMsg = addLoadingMessage();

    try {
      // Build conversation history
      const messages = [
        { role: 'user', content: userMessage }
      ];

      let responseText: string;

      switch (settings.provider) {
        case 'ollama':
          responseText = await callOllamaAPI(messages, settings);
          break;
        case 'openai':
          responseText = await callOpenAIAPI(messages, settings);
          break;
        case 'anthropic':
          responseText = await callAnthropicAPI(messages, settings);
          break;
        default:
          throw new Error(`Unsupported provider: ${settings.provider}`);
      }

      removeLoadingMessage();
      addMessage(responseText, false);

    } catch (error) {
      console.error('API Error:', error);
      removeLoadingMessage();
      addMessage(`❌ Error: ${(error as Error).message}. Please check your settings and try again.`, false);
    } finally {
      isGenerating = false;
      sendButton.disabled = false;
      messageInput.disabled = false;
      messageInput.focus();
    }
  }

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    if (isGenerating) return;
    
    const message = messageInput.value.trim();
    if (message) {
      addMessage(message, true);
      messageInput.value = '';
      generateResponse(message);
    }
  });

  clearChatBtn?.addEventListener('click', () => {
    loadChatHistory(currentChatId);
    chatHistories.delete(currentChatId);
  });

  // Listen for chat switches from sidebar
  window.addEventListener('chatSwitch', ((e: CustomEvent) => {
    saveChatHistory();
    currentChatId = e.detail.chatId;
    loadChatHistory(currentChatId);
  }) as EventListener);

  // Toggle sidebar on mobile
  toggleSidebarBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggleSidebar'));
  });

  // Update connection status on page load and when settings change
  updateConnectionStatus();
  window.addEventListener('storage', updateConnectionStatus);
  
  messageInput?.focus();
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out;
  }

  #messagesContainer::-webkit-scrollbar {
    width: 6px;
  }

  #messagesContainer::-webkit-scrollbar-track {
    background: transparent;
  }

  #messagesContainer::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 10px;
  }

  #messagesContainer::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .animate-bounce {
    animation: bounce 0.6s infinite;
  }
</style>
