---
// src/components/ChatSidebar.astro
---

<link rel="stylesheet" href="/src/styles/sidebar.css" />

<div class="sidebar-container">
  <!-- Sidebar Header -->
  <div class="sidebar-header">
    <button 
      id="newChatBtn"
      class="sidebar-new-chat-button"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      New Chat
    </button>
  </div>

  <!-- Chat List -->
  <div id="chatList" class="chat-list">
    <!-- Chats will be dynamically added here -->
    <div class="chat-item active" data-chat-id="1">
      <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-gray-50 cursor-pointer transition-colors bg-gray-100">
        <svg class="w-5 h-5 text-gray-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
        </svg>
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-medium text-gray-900 truncate">New Conversation</h3>
          <p class="text-xs text-gray-500 truncate mt-0.5">Just now</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">
    <div class="sidebar-footer-text">
      <span id="chatCount">1</span> conversation(s)
    </div>
  </div>
</div>

<script>
  interface Chat {
    id: number;
    title: string;
    lastMessage: string;
    timestamp: string;
  }

  let chats: Chat[] = [
    {
      id: 1,
      title: 'New Conversation',
      lastMessage: 'Welcome to Fellm',
      timestamp: 'Just now'
    }
  ];
  let activeChatId = 1;
  let nextChatId = 2;

  const chatList = document.getElementById('chatList');
  const newChatBtn = document.getElementById('newChatBtn');
  const chatCount = document.getElementById('chatCount');

  function updateChatCount() {
    if (chatCount) {
      chatCount.textContent = chats.length.toString();
    }
  }

  function getTimeAgo(date: Date): string {
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const minutes = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);

    if (minutes < 1) return 'Just now';
    if (minutes < 60) return `${minutes}m ago`;
    if (hours < 24) return `${hours}h ago`;
    return `${days}d ago`;
  }

  function renderChats() {
    if (!chatList) return;

    chatList.innerHTML = chats.map(chat => `
      <div class="chat-item ${chat.id === activeChatId ? 'active' : ''}" data-chat-id="${chat.id}">
        <div class="chat-list-item ${chat.id === activeChatId ? 'active' : ''} group">
          <svg class="chat-list-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
          </svg>
          <div class="chat-list-item-content">
            <h3 class="chat-list-item-title">${chat.title}</h3>
            <p class="chat-list-item-timestamp">${chat.timestamp}</p>
          </div>
          <button class="chat-delete-button" data-chat-id="${chat.id}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>
    `).join('');

    // Add click listeners to chat items
    document.querySelectorAll('.chat-item').forEach(item => {
      item.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.delete-chat')) return;
        
        const chatId = parseInt((item as HTMLElement).dataset.chatId || '0');
        switchChat(chatId);
      });
    });

    // Add delete listeners
    document.querySelectorAll('.chat-delete-button').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const chatId = parseInt((btn as HTMLElement).dataset.chatId || '0');
        deleteChat(chatId);
      });
    });
  }

  function switchChat(chatId: number) {
    activeChatId = chatId;
    renderChats();
    
    // Dispatch custom event to notify Chat component
    window.dispatchEvent(new CustomEvent('chatSwitch', { 
      detail: { chatId } 
    }));
  }

  function deleteChat(chatId: number) {
    if (chats.length === 1) {
      alert('You must have at least one conversation');
      return;
    }

    chats = chats.filter(chat => chat.id !== chatId);
    
    if (activeChatId === chatId) {
      activeChatId = chats[0].id;
      switchChat(activeChatId);
    }
    
    renderChats();
    updateChatCount();
  }

  function createNewChat() {
    const newChat: Chat = {
      id: nextChatId++,
      title: `Conversation ${nextChatId - 1}`,
      lastMessage: '',
      timestamp: 'Just now'
    };
    
    chats.unshift(newChat);
    activeChatId = newChat.id;
    renderChats();
    updateChatCount();
    
    // Notify Chat component
    window.dispatchEvent(new CustomEvent('chatSwitch', { 
      detail: { chatId: newChat.id } 
    }));
  }

  newChatBtn?.addEventListener('click', createNewChat);

  // Listen for chat updates from Chat component
  window.addEventListener('chatUpdate', ((e: CustomEvent) => {
    const { chatId, title, lastMessage } = e.detail;
    const chat = chats.find(c => c.id === chatId);
    if (chat) {
      if (title) chat.title = title;
      if (lastMessage) chat.lastMessage = lastMessage;
      chat.timestamp = 'Just now';
      renderChats();
    }
  }) as EventListener);

  // Initial render
  renderChats();
  updateChatCount();
</script>
