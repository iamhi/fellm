---
// src/pages/settings.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Settings - Fellm" activeTab="settings">
  <div class="min-h-[calc(100vh-3.5rem)] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <!-- Header -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 sm:p-8 shadow-sm">
        <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900 mb-2">
          Settings
        </h1>
        <p class="text-gray-600">
          Manage your preferences and account settings.
        </p>
      </div>

      <!-- Appearance Settings -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
          </svg>
          Appearance
        </h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div>
              <label for="theme" class="text-sm font-medium text-gray-900 block mb-1">
                Theme
              </label>
              <p class="text-xs text-gray-500">Choose your interface theme</p>
            </div>
            <select 
              id="theme" 
              class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="light">Light</option>
              <option value="dark">Dark</option>
              <option value="system">System</option>
            </select>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div>
              <label for="fontSize" class="text-sm font-medium text-gray-900 block mb-1">
                Font Size
              </label>
              <p class="text-xs text-gray-500">Adjust text size</p>
            </div>
            <select 
              id="fontSize" 
              class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="small">Small</option>
              <option value="medium" selected>Medium</option>
              <option value="large">Large</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Chat Settings -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          Chat Preferences
        </h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="soundEffects" class="text-sm font-medium text-gray-900 block mb-1">
                Sound Effects
              </label>
              <p class="text-xs text-gray-500">Play sounds for new messages</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="soundEffects" class="sr-only peer">
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="autoSave" class="text-sm font-medium text-gray-900 block mb-1">
                Auto-save Conversations
              </label>
              <p class="text-xs text-gray-500">Automatically save chat history</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="autoSave" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="enterToSend" class="text-sm font-medium text-gray-900 block mb-1">
                Enter to Send
              </label>
              <p class="text-xs text-gray-500">Press Enter to send messages</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="enterToSend" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- API Configuration -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
          API Configuration
        </h2>
        
        <div class="space-y-4">
          <div class="py-3 border-b border-gray-100">
            <label for="apiProvider" class="text-sm font-medium text-gray-900 block mb-2">
              API Provider
            </label>
            <select 
              id="apiProvider" 
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="openai">OpenAI</option>
              <option value="anthropic">Anthropic</option>
              <option value="google">Google AI</option>
              <option value="custom">Custom Endpoint</option>
            </select>
          </div>

          <div class="py-3 border-b border-gray-100">
            <label for="apiKey" class="text-sm font-medium text-gray-900 block mb-2">
              API Key
            </label>
            <div class="relative">
              <input 
                type="password" 
                id="apiKey" 
                placeholder="sk-..." 
                class="w-full px-3 py-2.5 pr-10 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
              />
              <button 
                id="toggleApiKey" 
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
              >
                <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <svg id="eyeOffIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                </svg>
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-1.5">Your API key is stored locally and never shared</p>
          </div>

          <div class="py-3 border-b border-gray-100">
            <label for="modelName" class="text-sm font-medium text-gray-900 block mb-2">
              Model
            </label>
            <select 
              id="modelName" 
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="gpt-4">GPT-4</option>
              <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
              <option value="claude-3-opus">Claude 3 Opus</option>
              <option value="claude-3-sonnet">Claude 3 Sonnet</option>
              <option value="gemini-pro">Gemini Pro</option>
            </select>
          </div>

          <div class="py-3 border-b border-gray-100">
            <label for="temperature" class="text-sm font-medium text-gray-900 block mb-2">
              Temperature: <span id="tempValue" class="text-gray-600">0.7</span>
            </label>
            <input 
              type="range" 
              id="temperature" 
              min="0" 
              max="2" 
              step="0.1" 
              value="0.7"
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-gray-900"
            />
            <div class="flex justify-between text-xs text-gray-500 mt-1">
              <span>Focused</span>
              <span>Balanced</span>
              <span>Creative</span>
            </div>
          </div>

          <div class="py-3 border-b border-gray-100 last:border-0">
            <label for="maxTokens" class="text-sm font-medium text-gray-900 block mb-2">
              Max Tokens
            </label>
            <input 
              type="number" 
              id="maxTokens" 
              value="2048"
              min="1"
              max="8192"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            />
            <p class="text-xs text-gray-500 mt-1.5">Maximum length of the model's response</p>
          </div>

          <div class="py-3">
            <button 
              id="testConnection"
              class="w-full px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              Test Connection
            </button>
          </div>
        </div>
      </div>

      <!-- Data & Privacy -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          Data & Privacy
        </h2>
        
        <div class="space-y-3">
          <button class="w-full text-left px-4 py-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700 flex items-center justify-between">
            <span>Export Chat History</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </button>

          <button class="w-full text-left px-4 py-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700 flex items-center justify-between">
            <span>Clear All Data</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3">
        <button class="flex-1 px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-sm font-medium">
          Save Changes
        </button>
        <a 
          href="/" 
          class="flex-1 px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium text-center"
        >
          Cancel
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Toggle API Key visibility
  const apiKeyInput = document.getElementById('apiKey') as HTMLInputElement;
  const toggleApiKeyBtn = document.getElementById('toggleApiKey');
  const eyeIcon = document.getElementById('eyeIcon');
  const eyeOffIcon = document.getElementById('eyeOffIcon');

  toggleApiKeyBtn?.addEventListener('click', () => {
    if (apiKeyInput.type === 'password') {
      apiKeyInput.type = 'text';
      eyeIcon?.classList.add('hidden');
      eyeOffIcon?.classList.remove('hidden');
    } else {
      apiKeyInput.type = 'password';
      eyeIcon?.classList.remove('hidden');
      eyeOffIcon?.classList.add('hidden');
    }
  });

  // Update temperature display
  const temperatureSlider = document.getElementById('temperature') as HTMLInputElement;
  const tempValue = document.getElementById('tempValue');

  temperatureSlider?.addEventListener('input', () => {
    if (tempValue) {
      tempValue.textContent = temperatureSlider.value;
    }
  });

  // Test API Connection
  const testConnectionBtn = document.getElementById('testConnection');
  
  testConnectionBtn?.addEventListener('click', async () => {
    const btn = testConnectionBtn as HTMLButtonElement;
    const originalText = btn.innerHTML;
    
    // Show loading state
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      Testing...
    `;

    // Simulate API test (replace with actual API call)
    await new Promise(resolve => setTimeout(resolve, 2000));

    // Show success
    btn.innerHTML = `
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      Connection Successful!
    `;
    btn.classList.add('bg-green-50', 'text-green-700', 'border-green-300');

    // Reset after 2 seconds
    setTimeout(() => {
      btn.disabled = false;
      btn.innerHTML = originalText;
      btn.classList.remove('bg-green-50', 'text-green-700', 'border-green-300');
    }, 2000);
  });

  // Save settings to localStorage
  const saveBtn = document.querySelector('button[class*="bg-gray-900"]');
  
  saveBtn?.addEventListener('click', () => {
    // Get all form values
    const theme = (document.getElementById('theme') as HTMLSelectElement)?.value;
    const fontSize = (document.getElementById('fontSize') as HTMLSelectElement)?.value;
    const soundEffects = (document.getElementById('soundEffects') as HTMLInputElement)?.checked;
    const autoSave = (document.getElementById('autoSave') as HTMLInputElement)?.checked;
    const enterToSend = (document.getElementById('enterToSend') as HTMLInputElement)?.checked;
    
    // API Configuration
    const apiProvider = (document.getElementById('apiProvider') as HTMLSelectElement)?.value;
    const apiKey = (document.getElementById('apiKey') as HTMLInputElement)?.value;
    const modelName = (document.getElementById('modelName') as HTMLSelectElement)?.value;
    const temperature = parseFloat((document.getElementById('temperature') as HTMLInputElement)?.value);
    const maxTokens = parseInt((document.getElementById('maxTokens') as HTMLInputElement)?.value);

    const settings = {
      theme,
      fontSize,
      soundEffects,
      autoSave,
      enterToSend,
      api: {
        provider: apiProvider,
        key: apiKey,
        model: modelName,
        temperature,
        maxTokens
      }
    };

    // Save to localStorage (in production, consider encryption for API keys)
    try {
      localStorage.setItem('fellm-settings', JSON.stringify(settings));
      alert('Settings saved successfully!');
      console.log('Settings saved:', settings);
    } catch (error) {
      alert('Failed to save settings. Please try again.');
      console.error('Save error:', error);
    }
  });

  // Load settings on page load
  window.addEventListener('DOMContentLoaded', () => {
    try {
      const saved = localStorage.getItem('fellm-settings');
      if (saved) {
        const settings = JSON.parse(saved);
        
        // Restore general settings
        if (settings.theme) (document.getElementById('theme') as HTMLSelectElement).value = settings.theme;
        if (settings.fontSize) (document.getElementById('fontSize') as HTMLSelectElement).value = settings.fontSize;
        if (settings.soundEffects !== undefined) (document.getElementById('soundEffects') as HTMLInputElement).checked = settings.soundEffects;
        if (settings.autoSave !== undefined) (document.getElementById('autoSave') as HTMLInputElement).checked = settings.autoSave;
        if (settings.enterToSend !== undefined) (document.getElementById('enterToSend') as HTMLInputElement).checked = settings.enterToSend;
        
        // Restore API settings
        if (settings.api) {
          if (settings.api.provider) (document.getElementById('apiProvider') as HTMLSelectElement).value = settings.api.provider;
          if (settings.api.key) (document.getElementById('apiKey') as HTMLInputElement).value = settings.api.key;
          if (settings.api.model) (document.getElementById('modelName') as HTMLSelectElement).value = settings.api.model;
          if (settings.api.temperature !== undefined) {
            (document.getElementById('temperature') as HTMLInputElement).value = settings.api.temperature.toString();
            if (tempValue) tempValue.textContent = settings.api.temperature.toString();
          }
          if (settings.api.maxTokens) (document.getElementById('maxTokens') as HTMLInputElement).value = settings.api.maxTokens.toString();
        }
      }
    } catch (error) {
      console.error('Failed to load settings:', error);
    }
  });
</script>
