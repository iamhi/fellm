---
// src/pages/settings.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Settings - Fellm" activeTab="settings">
  <div class="min-h-[calc(100vh-3.5rem)] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <!-- Header -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 sm:p-8 shadow-sm">
        <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900 mb-2">
          Settings
        </h1>
        <p class="text-gray-600">
          Manage your preferences and account settings.
        </p>
      </div>

      <!-- Appearance Settings -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
          </svg>
          Appearance
        </h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div>
              <label for="theme" class="text-sm font-medium text-gray-900 block mb-1">
                Theme
              </label>
              <p class="text-xs text-gray-500">Choose your interface theme</p>
            </div>
            <select 
              id="theme" 
              class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="light">Light</option>
              <option value="dark">Dark</option>
              <option value="system">System</option>
            </select>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div>
              <label for="fontSize" class="text-sm font-medium text-gray-900 block mb-1">
                Font Size
              </label>
              <p class="text-xs text-gray-500">Adjust text size</p>
            </div>
            <select 
              id="fontSize" 
              class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="small">Small</option>
              <option value="medium" selected>Medium</option>
              <option value="large">Large</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Chat Settings -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
          </svg>
          Chat Preferences
        </h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="soundEffects" class="text-sm font-medium text-gray-900 block mb-1">
                Sound Effects
              </label>
              <p class="text-xs text-gray-500">Play sounds for new messages</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="soundEffects" class="sr-only peer">
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="autoSave" class="text-sm font-medium text-gray-900 block mb-1">
                Auto-save Conversations
              </label>
              <p class="text-xs text-gray-500">Automatically save chat history</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="autoSave" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>

          <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
            <div class="flex-1">
              <label for="enterToSend" class="text-sm font-medium text-gray-900 block mb-1">
                Enter to Send
              </label>
              <p class="text-xs text-gray-500">Press Enter to send messages</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="enterToSend" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- API Configuration -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
          API Configuration
        </h2>
        
        <div class="space-y-4">
          <div class="py-3 border-b border-gray-100">
            <label for="apiProvider" class="text-sm font-medium text-gray-900 block mb-2">
              API Provider
            </label>
            <select 
              id="apiProvider" 
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <option value="openai">OpenAI</option>
              <option value="anthropic">Anthropic</option>
              <option value="google">Google AI</option>
              <option value="ollama">Ollama (Local)</option>
              <option value="custom">Custom Endpoint</option>
            </select>
          </div>

          <!-- Ollama Endpoint (shown when Ollama is selected) -->
          <div id="ollamaEndpoint" class="py-3 border-b border-gray-100 hidden">
            <label for="ollamaUrl" class="text-sm font-medium text-gray-900 block mb-2">
              Ollama Server URL
            </label>
            <input 
              type="text" 
              id="ollamaUrl" 
              placeholder="http://localhost:11434" 
              value="http://localhost:11434"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            />
            <p class="text-xs text-gray-500 mt-1.5">URL of your local Ollama server</p>
          </div>

          <!-- API Key (hidden for Ollama) -->
          <div id="apiKeySection" class="py-3 border-b border-gray-100">
            <label for="apiKey" class="text-sm font-medium text-gray-900 block mb-2">
              API Key
            </label>
            <div class="relative">
              <input 
                type="password" 
                id="apiKey" 
                placeholder="sk-..." 
                class="w-full px-3 py-2.5 pr-10 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
              />
              <button 
                id="toggleApiKey" 
                type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
              >
                <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                <svg id="eyeOffIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                </svg>
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-1.5">Your API key is stored locally and never shared</p>
          </div>

          <div class="py-3 border-b border-gray-100">
            <label for="modelName" class="text-sm font-medium text-gray-900 block mb-2">
              Model
            </label>
            <select 
              id="modelName" 
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            >
              <!-- OpenAI Models -->
              <optgroup label="OpenAI" id="openaiModels">
                <option value="gpt-4">GPT-4</option>
                <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
              </optgroup>
              
              <!-- Anthropic Models -->
              <optgroup label="Anthropic" id="anthropicModels">
                <option value="claude-3-opus">Claude 3 Opus</option>
                <option value="claude-3-sonnet">Claude 3 Sonnet</option>
              </optgroup>
              
              <!-- Google Models -->
              <optgroup label="Google" id="googleModels">
                <option value="gemini-pro">Gemini Pro</option>
              </optgroup>
              
              <!-- Ollama Models -->
              <optgroup label="Ollama" id="ollamaModels" class="hidden">
                <option value="llama3.2">Llama 3.2</option>
                <option value="llama3.1">Llama 3.1</option>
                <option value="mistral">Mistral</option>
                <option value="codellama">Code Llama</option>
                <option value="phi3">Phi-3</option>
                <option value="gemma2">Gemma 2</option>
                <option value="qwen2.5">Qwen 2.5</option>
              </optgroup>
            </select>
            <button 
              id="refreshOllamaModels"
              class="mt-2 text-xs text-gray-600 hover:text-gray-900 flex items-center gap-1 hidden"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
              Refresh available models
            </button>
          </div>

          <div class="py-3 border-b border-gray-100">
            <label for="temperature" class="text-sm font-medium text-gray-900 block mb-2">
              Temperature: <span id="tempValue" class="text-gray-600">0.7</span>
            </label>
            <input 
              type="range" 
              id="temperature" 
              min="0" 
              max="2" 
              step="0.1" 
              value="0.7"
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-gray-900"
            />
            <div class="flex justify-between text-xs text-gray-500 mt-1">
              <span>Focused</span>
              <span>Balanced</span>
              <span>Creative</span>
            </div>
          </div>

          <div class="py-3 border-b border-gray-100 last:border-0">
            <label for="maxTokens" class="text-sm font-medium text-gray-900 block mb-2">
              Max Tokens
            </label>
            <input 
              type="number" 
              id="maxTokens" 
              value="2048"
              min="1"
              max="8192"
              class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
            />
            <p class="text-xs text-gray-500 mt-1.5">Maximum length of the model's response</p>
          </div>

          <div class="py-3">
            <button 
              id="testConnection"
              class="w-full px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              Test Connection
            </button>
          </div>
        </div>
      </div>

      <!-- MCP Configuration -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            MCP Servers
          </h2>
          <button 
            id="addMcpServer"
            class="px-3 py-1.5 bg-gray-900 text-white text-sm rounded-md hover:bg-gray-800 transition-colors flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Add Server
          </button>
        </div>
        
        <p class="text-sm text-gray-600 mb-4">
          Connect to MCP servers to extend Fellm's capabilities with tools like file systems, APIs, databases, and more.
        </p>

        <!-- MCP Servers List -->
        <div id="mcpServersList" class="space-y-3">
          <!-- Servers will be dynamically added here -->
          <div class="text-center py-8 text-gray-500 text-sm" id="noServersMessage">
            No MCP servers configured. Click "Add Server" to get started.
          </div>
        </div>

        <!-- Add MCP Server Modal -->
        <div id="mcpModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
          <div class="bg-white rounded-lg max-w-lg w-full p-6 shadow-xl">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-gray-900">Add MCP Server</h3>
              <button id="closeMcpModal" class="text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>

            <div class="space-y-4">
              <div>
                <label for="mcpServerName" class="block text-sm font-medium text-gray-900 mb-1">
                  Server Name
                </label>
                <input 
                  type="text" 
                  id="mcpServerName"
                  placeholder="My MCP Server"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
                />
              </div>

              <div>
                <label for="mcpServerType" class="block text-sm font-medium text-gray-900 mb-1">
                  Server Type
                </label>
                <select 
                  id="mcpServerType"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
                >
                  <option value="stdio">stdio (Local)</option>
                  <option value="sse">SSE (HTTP)</option>
                </select>
              </div>

              <div id="stdioFields">
                <label for="mcpCommand" class="block text-sm font-medium text-gray-900 mb-1">
                  Command
                </label>
                <input 
                  type="text" 
                  id="mcpCommand"
                  placeholder="npx"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 mb-2"
                />
                <label for="mcpArgs" class="block text-sm font-medium text-gray-900 mb-1">
                  Arguments (one per line)
                </label>
                <textarea 
                  id="mcpArgs"
                  placeholder="-y&#10;@modelcontextprotocol/server-filesystem&#10;/path/to/directory"
                  rows="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
                ></textarea>
              </div>

              <div id="sseFields" class="hidden">
                <label for="mcpUrl" class="block text-sm font-medium text-gray-900 mb-1">
                  Server URL
                </label>
                <input 
                  type="url" 
                  id="mcpUrl"
                  placeholder="http://localhost:3000/sse"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
                />
              </div>

              <div class="flex gap-3 pt-4">
                <button 
                  id="saveMcpServer"
                  class="flex-1 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-sm font-medium"
                >
                  Add Server
                </button>
                <button 
                  id="cancelMcpModal"
                  class="flex-1 px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium"
                >
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Data & Privacy -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          Data & Privacy
        </h2>
        
        <div class="space-y-3">
          <button class="w-full text-left px-4 py-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700 flex items-center justify-between">
            <span>Export Chat History</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </button>

          <button class="w-full text-left px-4 py-3 rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700 flex items-center justify-between">
            <span>Clear All Data</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-3">
        <button class="flex-1 px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-sm font-medium">
          Save Changes
        </button>
        <a 
          href="/" 
          class="flex-1 px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium text-center"
        >
          Cancel
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // MCP Server Management
  interface MCPServer {
    id: string;
    name: string;
    type: 'stdio' | 'sse';
    command?: string;
    args?: string[];
    url?: string;
    enabled: boolean;
  }

  let mcpServers: MCPServer[] = [];

  function generateId(): string {
    return Date.now().toString(36) + Math.random().toString(36).substr(2);
  }

  function renderMCPServers() {
    const mcpServersList = document.getElementById('mcpServersList');
    const noServersMessage = document.getElementById('noServersMessage');
    
    if (!mcpServersList) return;

    if (mcpServers.length === 0) {
      noServersMessage?.classList.remove('hidden');
      return;
    }

    noServersMessage?.classList.add('hidden');

    mcpServersList.innerHTML = mcpServers.map(server => `
      <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50 transition-colors">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <h4 class="text-sm font-medium text-gray-900">${server.name}</h4>
              <span class="px-2 py-0.5 text-xs rounded-full ${server.type === 'stdio' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}">
                ${server.type}
              </span>
            </div>
            <p class="text-xs text-gray-500">
              ${server.type === 'stdio' 
                ? `${server.command} ${server.args?.slice(0, 2).join(' ')}...`
                : server.url}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" class="sr-only peer mcp-toggle" data-server-id="${server.id}" ${server.enabled ? 'checked' : ''}>
              <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-gray-900 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-gray-900"></div>
            </label>
            <button class="text-red-500 hover:text-red-700 delete-mcp" data-server-id="${server.id}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    `).join('');

    // Add event listeners for toggles
    document.querySelectorAll('.mcp-toggle').forEach(toggle => {
      toggle.addEventListener('change', (e) => {
        const serverId = (e.target as HTMLInputElement).dataset.serverId;
        const server = mcpServers.find(s => s.id === serverId);
        if (server) {
          server.enabled = (e.target as HTMLInputElement).checked;
          saveMCPServers();
        }
      });
    });

    // Add event listeners for delete buttons
    document.querySelectorAll('.delete-mcp').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const serverId = (btn as HTMLElement).dataset.serverId;
        if (confirm('Are you sure you want to remove this MCP server?')) {
          mcpServers = mcpServers.filter(s => s.id !== serverId);
          saveMCPServers();
          renderMCPServers();
        }
      });
    });
  }

  function saveMCPServers() {
    try {
      const settings = JSON.parse(localStorage.getItem('fellm-settings') || '{}');
      settings.mcpServers = mcpServers;
      localStorage.setItem('fellm-settings', JSON.stringify(settings));
    } catch (error) {
      console.error('Failed to save MCP servers:', error);
    }
  }

  function loadMCPServers() {
    try {
      const settings = JSON.parse(localStorage.getItem('fellm-settings') || '{}');
      if (settings.mcpServers) {
        mcpServers = settings.mcpServers;
        renderMCPServers();
      }
    } catch (error) {
      console.error('Failed to load MCP servers:', error);
    }
  }

  // MCP Modal Management
  const mcpModal = document.getElementById('mcpModal');
  const addMcpServerBtn = document.getElementById('addMcpServer');
  const closeMcpModalBtn = document.getElementById('closeMcpModal');
  const cancelMcpModalBtn = document.getElementById('cancelMcpModal');
  const saveMcpServerBtn = document.getElementById('saveMcpServer');
  const mcpServerType = document.getElementById('mcpServerType') as HTMLSelectElement;
  const stdioFields = document.getElementById('stdioFields');
  const sseFields = document.getElementById('sseFields');

  function openMcpModal() {
    mcpModal?.classList.remove('hidden');
    // Reset form
    (document.getElementById('mcpServerName') as HTMLInputElement).value = '';
    (document.getElementById('mcpCommand') as HTMLInputElement).value = 'npx';
    (document.getElementById('mcpArgs') as HTMLTextAreaElement).value = '';
    (document.getElementById('mcpUrl') as HTMLInputElement).value = '';
  }

  function closeMcpModal() {
    mcpModal?.classList.add('hidden');
  }

  addMcpServerBtn?.addEventListener('click', openMcpModal);
  closeMcpModalBtn?.addEventListener('click', closeMcpModal);
  cancelMcpModalBtn?.addEventListener('click', closeMcpModal);

  mcpServerType?.addEventListener('change', () => {
    if (mcpServerType.value === 'stdio') {
      stdioFields?.classList.remove('hidden');
      sseFields?.classList.add('hidden');
    } else {
      stdioFields?.classList.add('hidden');
      sseFields?.classList.remove('hidden');
    }
  });

  saveMcpServerBtn?.addEventListener('click', () => {
    const name = (document.getElementById('mcpServerName') as HTMLInputElement).value.trim();
    const type = (document.getElementById('mcpServerType') as HTMLSelectElement).value as 'stdio' | 'sse';

    if (!name) {
      alert('Please enter a server name');
      return;
    }

    const server: MCPServer = {
      id: generateId(),
      name,
      type,
      enabled: true
    };

    if (type === 'stdio') {
      const command = (document.getElementById('mcpCommand') as HTMLInputElement).value.trim();
      const argsText = (document.getElementById('mcpArgs') as HTMLTextAreaElement).value.trim();
      
      if (!command) {
        alert('Please enter a command');
        return;
      }

      server.command = command;
      server.args = argsText.split('\n').filter(arg => arg.trim());
    } else {
      const url = (document.getElementById('mcpUrl') as HTMLInputElement).value.trim();
      
      if (!url) {
        alert('Please enter a server URL');
        return;
      }

      server.url = url;
    }

    mcpServers.push(server);
    saveMCPServers();
    renderMCPServers();
    closeMcpModal();
  });

  // Provider change handler
  const apiProvider = document.getElementById('apiProvider') as HTMLSelectElement;
  const apiKeySection = document.getElementById('apiKeySection');
  const ollamaEndpoint = document.getElementById('ollamaEndpoint');
  const ollamaModels = document.getElementById('ollamaModels');
  const refreshOllamaBtn = document.getElementById('refreshOllamaModels');
  const modelSelect = document.getElementById('modelName') as HTMLSelectElement;

  function updateProviderUI() {
    const provider = apiProvider.value;
    
    if (provider === 'ollama') {
      // Show Ollama-specific fields
      apiKeySection?.classList.add('hidden');
      ollamaEndpoint?.classList.remove('hidden');
      ollamaModels?.classList.remove('hidden');
      refreshOllamaBtn?.classList.remove('hidden');
      
      // Select first Ollama model
      const firstOllamaOption = ollamaModels?.querySelector('option');
      if (firstOllamaOption) {
        modelSelect.value = (firstOllamaOption as HTMLOptionElement).value;
      }
    } else {
      // Show API key field for cloud providers
      apiKeySection?.classList.remove('hidden');
      ollamaEndpoint?.classList.add('hidden');
      ollamaModels?.classList.add('hidden');
      refreshOllamaBtn?.classList.add('hidden');
      
      // Select appropriate model for provider
      if (provider === 'openai') {
        modelSelect.value = 'gpt-4';
      } else if (provider === 'anthropic') {
        modelSelect.value = 'claude-3-opus';
      } else if (provider === 'google') {
        modelSelect.value = 'gemini-pro';
      }
    }
  }

  apiProvider?.addEventListener('change', updateProviderUI);

  // Fetch available Ollama models
  async function fetchOllamaModels() {
    const ollamaUrl = (document.getElementById('ollamaUrl') as HTMLInputElement)?.value || 'http://localhost:11434';
    const btn = refreshOllamaBtn as HTMLButtonElement;
    
    if (!btn) return;
    
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-3 h-3 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      Fetching models...
    `;

    try {
      const response = await fetch(`${ollamaUrl}/api/tags`);
      if (!response.ok) throw new Error('Failed to fetch models');
      
      const data = await response.json();
      
      // Clear existing Ollama models
      if (ollamaModels) {
        ollamaModels.innerHTML = '';
        
        // Add fetched models
        if (data.models && data.models.length > 0) {
          data.models.forEach((model: any) => {
            const option = document.createElement('option');
            option.value = model.name;
            option.textContent = `${model.name} (${(model.size / 1e9).toFixed(1)}GB)`;
            ollamaModels.appendChild(option);
          });
          
          // Select first model
          modelSelect.value = data.models[0].name;
        } else {
          const option = document.createElement('option');
          option.textContent = 'No models found';
          option.disabled = true;
          ollamaModels.appendChild(option);
        }
      }
      
      btn.innerHTML = `
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        Models loaded
      `;
      
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }, 2000);
      
    } catch (error) {
      console.error('Error fetching Ollama models:', error);
      btn.innerHTML = `
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Failed to load
      `;
      
      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }, 2000);
    }
  }

  refreshOllamaBtn?.addEventListener('click', fetchOllamaModels);

  // Toggle API Key visibility
  const apiKeyInput = document.getElementById('apiKey') as HTMLInputElement;
  const toggleApiKeyBtn = document.getElementById('toggleApiKey');
  const eyeIcon = document.getElementById('eyeIcon');
  const eyeOffIcon = document.getElementById('eyeOffIcon');

  toggleApiKeyBtn?.addEventListener('click', () => {
    if (apiKeyInput.type === 'password') {
      apiKeyInput.type = 'text';
      eyeIcon?.classList.add('hidden');
      eyeOffIcon?.classList.remove('hidden');
    } else {
      apiKeyInput.type = 'password';
      eyeIcon?.classList.remove('hidden');
      eyeOffIcon?.classList.add('hidden');
    }
  });

  // Update temperature display
  const temperatureSlider = document.getElementById('temperature') as HTMLInputElement;
  const tempValue = document.getElementById('tempValue');

  temperatureSlider?.addEventListener('input', () => {
    if (tempValue) {
      tempValue.textContent = temperatureSlider.value;
    }
  });

  // Test API Connection
  const testConnectionBtn = document.getElementById('testConnection');
  
  testConnectionBtn?.addEventListener('click', async () => {
    const btn = testConnectionBtn as HTMLButtonElement;
    const originalText = btn.innerHTML;
    const provider = apiProvider.value;
    
    // Show loading state
    btn.disabled = true;
    btn.innerHTML = `
      <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
      Testing...
    `;

    try {
      if (provider === 'ollama') {
        // Test Ollama connection
        const ollamaUrl = (document.getElementById('ollamaUrl') as HTMLInputElement)?.value || 'http://localhost:11434';
        const response = await fetch(`${ollamaUrl}/api/tags`);
        
        if (!response.ok) throw new Error('Ollama server not responding');
        
        const data = await response.json();
        if (!data.models || data.models.length === 0) {
          throw new Error('No models found. Run "ollama pull <model>" to download a model.');
        }
      } else {
        // Simulate cloud API test
        await new Promise(resolve => setTimeout(resolve, 2000));
      }

      // Show success
      btn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        Connection Successful!
      `;
      btn.classList.add('bg-green-50', 'text-green-700', 'border-green-300');
    } catch (error) {
      // Show error
      btn.innerHTML = `
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Connection Failed
      `;
      btn.classList.add('bg-red-50', 'text-red-700', 'border-red-300');
      console.error('Connection error:', error);
    }

    // Reset after 2 seconds
    setTimeout(() => {
      btn.disabled = false;
      btn.innerHTML = originalText;
      btn.classList.remove('bg-green-50', 'text-green-700', 'border-green-300');
      btn.classList.remove('bg-red-50', 'text-red-700', 'border-red-300');
    }, 2000);
  });

  // Save settings to localStorage
  const saveBtn = document.querySelector('button[class*="bg-gray-900"]');
  
  saveBtn?.addEventListener('click', () => {
    // Get all form values
    const theme = (document.getElementById('theme') as HTMLSelectElement)?.value;
    const fontSize = (document.getElementById('fontSize') as HTMLSelectElement)?.value;
    const soundEffects = (document.getElementById('soundEffects') as HTMLInputElement)?.checked;
    const autoSave = (document.getElementById('autoSave') as HTMLInputElement)?.checked;
    const enterToSend = (document.getElementById('enterToSend') as HTMLInputElement)?.checked;
    
    // API Configuration
    const provider = (document.getElementById('apiProvider') as HTMLSelectElement)?.value;
    const apiKey = (document.getElementById('apiKey') as HTMLInputElement)?.value;
    const ollamaUrl = (document.getElementById('ollamaUrl') as HTMLInputElement)?.value;
    const modelName = (document.getElementById('modelName') as HTMLSelectElement)?.value;
    const temperature = parseFloat((document.getElementById('temperature') as HTMLInputElement)?.value);
    const maxTokens = parseInt((document.getElementById('maxTokens') as HTMLInputElement)?.value);

    const settings = {
      theme,
      fontSize,
      soundEffects,
      autoSave,
      enterToSend,
      api: {
        provider,
        key: apiKey,
        ollamaUrl,
        model: modelName,
        temperature,
        maxTokens
      }
    };

    // Save to localStorage (in production, consider encryption for API keys)
    try {
      localStorage.setItem('fellm-settings', JSON.stringify(settings));
      alert('Settings saved successfully!');
      console.log('Settings saved:', settings);
    } catch (error) {
      alert('Failed to save settings. Please try again.');
      console.error('Save error:', error);
    }
  });

  // Load settings on page load
  window.addEventListener('DOMContentLoaded', () => {
    // Load MCP servers first
    loadMCPServers();
    
    try {
      const saved = localStorage.getItem('fellm-settings');
      if (saved) {
        const settings = JSON.parse(saved);
        
        // Restore general settings
        if (settings.theme) (document.getElementById('theme') as HTMLSelectElement).value = settings.theme;
        if (settings.fontSize) (document.getElementById('fontSize') as HTMLSelectElement).value = settings.fontSize;
        if (settings.soundEffects !== undefined) (document.getElementById('soundEffects') as HTMLInputElement).checked = settings.soundEffects;
        if (settings.autoSave !== undefined) (document.getElementById('autoSave') as HTMLInputElement).checked = settings.autoSave;
        if (settings.enterToSend !== undefined) (document.getElementById('enterToSend') as HTMLInputElement).checked = settings.enterToSend;
        
        // Restore API settings
        if (settings.api) {
          if (settings.api.provider) {
            (document.getElementById('apiProvider') as HTMLSelectElement).value = settings.api.provider;
            updateProviderUI(); // Update UI based on provider
          }
          if (settings.api.key) (document.getElementById('apiKey') as HTMLInputElement).value = settings.api.key;
          if (settings.api.ollamaUrl) (document.getElementById('ollamaUrl') as HTMLInputElement).value = settings.api.ollamaUrl;
          if (settings.api.model) (document.getElementById('modelName') as HTMLSelectElement).value = settings.api.model;
          if (settings.api.temperature !== undefined) {
            (document.getElementById('temperature') as HTMLInputElement).value = settings.api.temperature.toString();
            if (tempValue) tempValue.textContent = settings.api.temperature.toString();
          }
          if (settings.api.maxTokens) (document.getElementById('maxTokens') as HTMLInputElement).value = settings.api.maxTokens.toString();
        }
      }
      
      // Initialize UI based on current provider
      updateProviderUI();
    } catch (error) {
      console.error('Failed to load settings:', error);
    }
  });
</script>
