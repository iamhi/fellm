---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat.astro';
---

<BaseLayout title="Chat - My Astro App" activeTab="chat">
  <!-- Fullscreen Chat Container -->
  <div class="fixed inset-0 top-16 bottom-0 left-0 right-0">
    <Chat />
  </div>
</BaseLayout>

<style>
  /* Override the default main padding for fullscreen */
  :global(main) {
    padding: 0 !important;
    max-width: 100% !important;
  }
</style>
