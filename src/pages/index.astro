---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatSidebar from '../components/ChatSidebar.astro';
import Chat from '../components/Chat.astro';
---

<BaseLayout title="Chat - Fellm" activeTab="home">
  <div class="h-[calc(100vh-3.5rem)] p-4 sm:p-6 lg:p-8">
    <div class="h-full max-w-7xl mx-auto flex gap-4">
      <!-- Sidebar - Desktop -->
      <aside id="sidebar" class="hidden lg:block w-72 flex-shrink-0">
        <div class="h-full rounded-lg border-2 border-gray-200 shadow-sm overflow-hidden bg-gray-50">
          <ChatSidebar />
        </div>
      </aside>

      <!-- Mobile Sidebar Overlay -->
      <div id="sidebarOverlay" class="fixed inset-0 bg-black bg-opacity-0 z-40 lg:hidden transition-all duration-300 pointer-events-none opacity-0">
        <div id="sidebarDrawer" class="fixed inset-y-0 left-0 w-80 bg-gray-50 shadow-2xl transform -translate-x-full transition-transform duration-300 ease-out">
          <div class="h-full flex flex-col">
            <div class="flex items-center justify-between p-4 border-b border-gray-200 bg-white">
              <h2 class="text-lg font-semibold text-gray-900">Conversations</h2>
              <button id="closeSidebar" class="text-gray-600 hover:text-gray-900 transition-colors p-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
            </div>
            <div class="flex-1 overflow-hidden">
              <ChatSidebar />
            </div>
          </div>
        </div>
      </div>

      <!-- Main Chat Area -->
      <main class="flex-1 min-w-0">
        <Chat />
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  const sidebarOverlay = document.getElementById('sidebarOverlay');
  const sidebarDrawer = document.getElementById('sidebarDrawer');
  const closeSidebarBtn = document.getElementById('closeSidebar');

  function openSidebar() {
    if (sidebarOverlay && sidebarDrawer) {
      // Enable pointer events and start fade in
      sidebarOverlay.classList.remove('pointer-events-none', 'opacity-0');
      sidebarOverlay.classList.add('pointer-events-auto', 'bg-opacity-50');
      
      // Slide in drawer
      setTimeout(() => {
        sidebarDrawer.classList.remove('-translate-x-full');
        sidebarDrawer.classList.add('translate-x-0');
      }, 10);
    }
  }

  function closeSidebar() {
    if (sidebarOverlay && sidebarDrawer) {
      // Slide out drawer
      sidebarDrawer.classList.remove('translate-x-0');
      sidebarDrawer.classList.add('-translate-x-full');
      
      // Fade out overlay
      sidebarOverlay.classList.remove('bg-opacity-50');
      sidebarOverlay.classList.add('opacity-0');
      
      // Disable pointer events after animation
      setTimeout(() => {
        sidebarOverlay.classList.remove('pointer-events-auto');
        sidebarOverlay.classList.add('pointer-events-none');
      }, 300);
    }
  }

  // Toggle sidebar on mobile
  window.addEventListener('toggleSidebar', openSidebar);

  // Close sidebar
  closeSidebarBtn?.addEventListener('click', closeSidebar);

  // Close on overlay click
  sidebarOverlay?.addEventListener('click', (e) => {
    if (e.target === sidebarOverlay) {
      closeSidebar();
    }
  });

  // Close sidebar when switching chats on mobile
  window.addEventListener('chatSwitch', closeSidebar);
</script>
