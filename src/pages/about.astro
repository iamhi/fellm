---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Settings- My Astro App" activeTab="settings">
  <div class="space-y-6">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-4xl font-bold text-gray-800 mb-4">
        About This Project 📚
      </h1>
      <p class="text-lg text-gray-600 mb-6">
        Learn more about the technologies powering this application.
      </p>
      
      <div class="prose prose-lg max-w-none">
        <h2 class="text-2xl font-semibold text-gray-800 mb-3">
          What is Astro?
        </h2>
        <p class="text-gray-700 mb-4">
          Astro is a modern web framework designed for speed. It delivers 
          lightning-fast performance by shipping zero JavaScript by default, 
          only adding interactivity where needed.
        </p>

        <h2 class="text-2xl font-semibold text-gray-800 mb-3 mt-6">
          Key Features
        </h2>
        <ul class="space-y-2 text-gray-700">
          <li class="flex items-start">
            <span class="text-green-500 mr-2 mt-1">✓</span>
            <span><strong>View Transitions:</strong> Smooth page navigation without full reloads</span>
          </li>
          <li class="flex items-start">
            <span class="text-green-500 mr-2 mt-1">✓</span>
            <span><strong>Component Islands:</strong> Hydrate interactive components only when needed</span>
          </li>
          <li class="flex items-start">
            <span class="text-green-500 mr-2 mt-1">✓</span>
            <span><strong>Framework Agnostic:</strong> Use React, Vue, Svelte, or vanilla JS</span>
          </li>
          <li class="flex items-start">
            <span class="text-green-500 mr-2 mt-1">✓</span>
            <span><strong>Built-in Optimizations:</strong> Image optimization, CSS bundling, and more</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-orange-50 rounded-lg p-6 text-center">
        <div class="text-4xl mb-3">⚡</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Fast</h3>
        <p class="text-gray-600">Zero JS by default</p>
      </div>
      
      <div class="bg-blue-50 rounded-lg p-6 text-center">
        <div class="text-4xl mb-3">🎨</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Flexible</h3>
        <p class="text-gray-600">Use any UI framework</p>
      </div>
      
      <div class="bg-green-50 rounded-lg p-6 text-center">
        <div class="text-4xl mb-3">🚀</div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Modern</h3>
        <p class="text-gray-600">Latest web standards</p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8 text-center">
      <p class="text-gray-600 mb-4">Ready to go back?</p>
      <a 
        href="/" 
        class="inline-block bg-blue-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-600 transition-colors"
      >
        ← Back to Chat 
      </a>
    </div>
  </div>
</BaseLayout>
