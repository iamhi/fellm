---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - Fellm" activeTab="about">
  <div class="min-h-[calc(100vh-3.5rem)] py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white rounded-lg border border-gray-200 p-6 sm:p-8 shadow-sm">
        <h1 class="text-3xl sm:text-4xl font-semibold text-gray-900 mb-4">
          About Fellm
        </h1>
        <p class="text-gray-600 text-lg mb-8">
          A modern chat application built with cutting-edge web technologies.
        </p>
        
        <div class="space-y-6">
          <div>
            <h2 class="text-xl font-semibold text-gray-900 mb-3">
              Built With
            </h2>
            <div class="space-y-2 text-gray-600">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-gray-900 rounded-full"></span>
                <span><strong>Astro</strong> - Fast, modern web framework</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-gray-900 rounded-full"></span>
                <span><strong>Tailwind CSS</strong> - Utility-first CSS framework</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-gray-900 rounded-full"></span>
                <span><strong>TypeScript</strong> - Type-safe JavaScript</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-gray-900 rounded-full"></span>
                <span><strong>View Transitions</strong> - Smooth page navigation</span>
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-xl font-semibold text-gray-900 mb-3">
              Features
            </h2>
            <div class="space-y-2 text-gray-600">
              <div class="flex items-center gap-2">
                <span class="text-green-600">✓</span>
                <span>Clean, minimalist design</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600">✓</span>
                <span>Fully responsive layout</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600">✓</span>
                <span>Real-time chat interface</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600">✓</span>
                <span>Smooth animations and transitions</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-200">
          <a 
            href="/" 
            class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Chat
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
